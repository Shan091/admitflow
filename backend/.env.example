# AdmitFlow backend — environment template. Copy to .env and fill in.
# Model IDs are config-driven (ADR-007): version strings live HERE, not in docs/code.

# --- App ---
APP_NAME=AdmitFlow
APP_ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# --- Data stores (ADR-007) — wired up in Task 2 / Task 3 ---
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname
# REDIS_URL=redis://localhost:6379/0

# --- PII protection (SPEC §14) — master key encrypts PII columns; pepper keys phone-hash lookup ---
# Generate the Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PII_ENCRYPTION_KEY=
# PHONE_HASH_KEY=

# --- Meta WhatsApp (Task 5/6) ---
LEGACY_WHATSAPP_ENABLED=false
# META_APP_SECRET=           # App secret from Meta dashboard (HMAC body verification)
# WHATSAPP_VERIFY_TOKEN=     # Your chosen token for GET webhook challenge
# WHATSAPP_ACCESS_TOKEN=     # System user / permanent token from Meta
# WHATSAPP_PHONE_NUMBER_ID=  # Phone number ID (not the phone number itself)
META_GRAPH_API_VERSION=v21.0

# --- LLM model roles (config-driven; ADR-007 "LLM efficiency") ---
# Code references roles (fast / fallback / nuance); only the IDs live here.
LLM_FAST_MODEL=openai/gpt-4.1-mini
# LLM_FALLBACK_MODEL=
# LLM_NUANCE_MODEL=

# --- Institution knowledge workspace (OpenAI embeddings) ---
# OPENAI_API_KEY=
LLM_EMBEDDING_MODEL=text-embedding-3-small
# STAFF_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# STAFF_SESSION_HOURS=8
# DEMO_CREDENTIALS_PATH=.demo-credentials.json
# UPLOAD_MAX_BYTES=10485760
# UPLOAD_BATCH_MAX_BYTES=31457280
# UPLOAD_BATCH_FILES=25
# INGESTION_TIMEOUT_SECONDS=180
# KNOWLEDGE_MIN_SIMILARITY=0.3
# Always attempt OpenAI reranking for 2+ eligible passages; timeout retains baseline.
KNOWLEDGE_RERANK_TIMEOUT_SECONDS=8
# KNOWLEDGE_RECOVERY_ENABLED=true

# --- Telegram private-chat receiver ---
# TELEGRAM_BOT_TOKEN=
TELEGRAM_INSTITUTION_CODE=demo

# Manually provision encrypted institution-owned payment credentials with
# python -m src.scripts.provision_payments --institution-code demo
# Use Razorpay test keys during validation; do not paste secrets in chat.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_LIVE_ENABLED=false
LLM_TIMEOUT_SECONDS=30


# Opted-in, bounded reminders; also requires the scheduler and configured office hours.
FOLLOWUPS_ENABLED=true
# Maximum records per staff CSV/Excel download; exports never silently truncate.
STAFF_EXPORT_MAX_ROWS=10000
# API sweeper for committed webhook events; the scheduler also recovers them.
INTEGRATION_RECOVERY_ENABLED=true
